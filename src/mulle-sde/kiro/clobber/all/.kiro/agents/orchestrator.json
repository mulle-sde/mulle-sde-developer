      ],
      "trustedAgents": [
        "planner",
        "coder",
        "verifier",
        "debugger",
        "doc-writer",
        "reviewer"
      ]
    }
  },
  "useLegacyMcpJson": false,
  "model": "claude-sonnet-4.6"
}
